<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic background image that can be tinted -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY" />

    <!-- Left side metadata container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@id/widget_right_container"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="Song Title"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Artist Name"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Right side container for artwork & controls overlay -->
    <RelativeLayout
        android:id="@+id/widget_right_container"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true">

        <!-- Artwork image -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <!-- Linear gradient horizontal overlay -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_gradient_horizontal" />

        <!-- Overlay controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Previous button -->
            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_prev"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:layout_marginRight="4dp" />

            <!-- Circular Play/Pause button -->
            <RelativeLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="4dp">

                <!-- Circular button background -->
                <ImageView
                    android:id="@+id/widget_play_pause_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_button_background" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_play" />
            </RelativeLayout>

            <!-- Next button -->
            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_next"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
