<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic background image -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY" />

    <!-- Container for metadata and controls top, lyrics bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top block: Metadata, divider, and controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded artwork -->
            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <!-- Song info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="Song Title"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Artist Name"
                    android:textColor="#AAFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Vertical separator -->
            <ImageView
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="#22FFFFFF"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp" />

            <!-- Play/Pause -->
            <RelativeLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="6dp">

                <ImageView
                    android:id="@+id/widget_play_pause_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_button_background" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_play" />
            </RelativeLayout>

            <!-- Next button -->
            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_next"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Bottom block: Active lyric -->
        <TextView
            android:id="@+id/widget_lyric_active"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Lyrics will appear here..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</RelativeLayout>
